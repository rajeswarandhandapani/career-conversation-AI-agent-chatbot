# Model selection: LangChain "provider:model" string (default: openai:gpt-5-mini)
# Examples: openai:gpt-5-mini | anthropic:claude-sonnet-5 | groq:openai/gpt-oss-120b
CHAT_MODEL=openai:gpt-5-mini

# API key for whichever provider CHAT_MODEL uses
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Optional: Pushover notifications
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
